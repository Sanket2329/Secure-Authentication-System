# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secure_auth
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secure_auth

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=super_secret_access_key_change_me_in_prod
JWT_ACCESS_EXPIRES_IN=15m

# Refresh Token
# A cryptographically secure secret used to generate hashes for the refresh tokens
REFRESH_TOKEN_SECRET=super_secret_refresh_key_change_me_in_prod
REFRESH_TOKEN_EXPIRES_DAYS=7

# Client URL (for CORS)
CLIENT_URL=http://localhost:8080
